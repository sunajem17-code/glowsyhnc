  "referencePolicy": {
    "source": "User-supplied PSL guide",
    "status": "Subjective community examples; not verified reference-image ratings",
    "scope": "The supplied named examples are male; their role is to explain anchor levels, not impose male feature shapes on every subject. No female reference-image set was supplied.",
    "imageCalibration": "No reference photographs supplied. Never claim a visual match or direct photo comparison from these names."
  },
  "featureRules": {
    "facialHarmony": "Evaluate how feature relationships work together across the whole face. An isolated striking trait cannot establish exceptional overall harmony.",
    "facialBalance": "Describe visible vertical and horizontal relationships without enforcing exact golden ratios or fabricating measurements.",
    "visibleSymmetry": "Consider noticeable differences in a neutral view. Account for pose, lens distortion and expression; ordinary asymmetry is not a defect by itself.",
    "eyeArea": "Assess visible spacing, shape, eyelids and brow relationship. Do not require hunter eyes or infer orbital bone support from shadows.",
    "lowerFace": "Assess visible jaw contour and chin proportions. Discuss projection only from a usable side view; do not infer bite or jaw diagnoses.",
    "midfaceCheeks": "Assess visible cheek contours and midface relationships, separating lighting and soft tissue from unsupported skeletal claims.",
    "noseLips": "Assess how nose and lip proportions fit the surrounding face. No universal ideal shape, size or ethnicity template.",
    "skinPresentation": "Assess visible clarity and texture only. Do not estimate collagen, health, age, body fat or grooming effort. Skin alone cannot establish a high structural rating.",
    "distinctiveQualities": "Describe distinctive features in context; uniqueness is neither automatically a bonus nor a penalty, and averageness is not mandatory."
  },
